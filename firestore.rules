rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    match /users/{uid}/{collection}/{id} {
      allow read: if owner(uid) && collection in ['readings', 'insights'];
      allow create, update: if owner(uid) && collection in ['readings', 'insights'] && request.resource.data.keys().hasOnly(['value','updatedAt','deleted']) && request.resource.data.updatedAt is timestamp && request.resource.data.deleted is bool;
      allow delete: if owner(uid) && collection in ['readings', 'insights'];
      match /chunks/{chunk} {
        allow read, write: if owner(uid) && collection == 'readings';
      }
    }
  }
}
